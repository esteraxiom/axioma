#!/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
set -euo pipefail

state_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/axioma
state_file=${state_dir}/welcome-complete
install -d -m 0700 "$state_dir"

yad --title='Welcome to Axioma' --width=620 --image=computer \
    --text='<big><b>Welcome to Axioma</b></big>\n\nAxioma Setup can inspect the image, migrate your CachyOS home, mount your data disks, and enable optional services.' \
    --button='Open Axioma Setup':0 --button='Later':1 && \
    cosmic-term -e /usr/bin/axioma-setup

touch "$state_file"
